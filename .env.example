# Copia este archivo como .env y ajusta lo que necesites.
# Las credenciales de MySQL NO van aquí: ver backend/api/config.example.php

# Dirección pública del sitio (canónicas, Open Graph, sitemap y robots.txt)
SITE_URL=https://www.molleytara.example

# Subcarpeta donde se publica. En la raíz del dominio: /
BASE_PATH=/

# URL del endpoint PHP. Vacío = <BASE_PATH>api/contacto.php
PUBLIC_CONTACT_ENDPOINT=

# Solo para "npm run dev": a dónde se reenvían las llamadas a /api
PHP_BACKEND_URL=http://localhost/molle-y-tara
